# ===== About Me 后端配置 =====
# 复制此文件为 .env 并填写你的配置

# 服务端口
PORT=3000

# ----- 食物图片识别（大模型视觉 API）-----
# 三选一：zhipu（智谱GLM-4V，有免费额度）/ qwen（通义千问VL）/ openai（GPT-4o）
# 不填写则“上传图片识别”会提示先配置，其余功能不受影响。
VISION_PROVIDER=zhipu
VISION_API_KEY=

# 可选：覆盖模型与接口根地址（地址不含 /chat/completions，会自动补全）
# 本地 ollama 示例：
#   VISION_PROVIDER=openai
#   VISION_API_KEY=ollama-local
#   VISION_BASE_URL=http://localhost:11434/v1
#   VISION_MODEL=qwen2.5vl:3b
# VISION_MODEL=glm-4v-flash
# VISION_BASE_URL=

# ----- 短信验证码（真实手机号登录）-----
# SMS_PROVIDER 三选一：aliyun（阿里云短信）/ twilio / webhook
# 不填写则自动进入「开发模式」：验证码直接显示在页面上，并打印到终端。
#
# 【阿里云短信】SMS_PROVIDER=aliyun
#   SMS_ACCESS_KEY_ID=你的AccessKeyId
#   SMS_ACCESS_KEY_SECRET=你的AccessKeySecret
#   SMS_SIGN_NAME=你的短信签名（需在阿里云审核通过）
#   SMS_TEMPLATE_CODE=你的模板CODE（如 SMS_123456789）
#   SMS_REGION_ID=cn-hangzhou
#   模板内容示例：您的验证码为 ${code}，5分钟内有效，请勿泄露。
#
# 【Twilio】SMS_PROVIDER=twilio
#   TWILIO_ACCOUNT_SID=
#   TWILIO_AUTH_TOKEN=
#   TWILIO_FROM=+1xxxxxxxxxx
#
# 【自建转发】SMS_PROVIDER=webhook
#   SMS_WEBHOOK_URL=https://你的服务/send
#   （会以 POST JSON { phone, code, signName, templateCode } 调用）
SMS_PROVIDER=
