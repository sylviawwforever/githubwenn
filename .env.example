# ===== About Me 后端配置 =====
# 复制此文件为 .env 并填写。不要把真实密钥提交到 Git。

# 服务端口
PORT=3000

# ----- 食物图片识别（大模型视觉 API）-----
# 默认 DeepSeek 图像理解模型 deepseek-flash。
# 也兼容 zhipu（智谱 GLM-4V）/ qwen（通义千问 VL）/ openai（GPT-4o 等）。
# 不填写 VISION_API_KEY 时，上传图片会提示先配置，手动录入和食物库估算仍然可用。
VISION_PROVIDER=deepseek
VISION_API_KEY=
# OpenAI 兼容根地址。代码会自动补上 /chat/completions。
# https://api.deepseek.com 与 https://api.deepseek.com/v1 都可以。
VISION_BASE_URL=https://api.deepseek.com
# 图像理解模型。deepseek-v4-pro 不支持图片，请保持 deepseek-flash。
VISION_MODEL=deepseek-flash

# 其他服务商示例（改 VISION_PROVIDER 后，可删掉上面的 BASE_URL / MODEL，或改成对应地址）：
# VISION_PROVIDER=zhipu
# VISION_MODEL=glm-4v-flash
# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#
# VISION_PROVIDER=qwen
# VISION_MODEL=qwen-vl-plus
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# VISION_PROVIDER=openai
# VISION_MODEL=gpt-4o-mini
# VISION_BASE_URL=https://api.openai.com/v1
#
# 本地 ollama：
# VISION_PROVIDER=openai
# VISION_API_KEY=ollama-local
# VISION_BASE_URL=http://localhost:11434/v1
# VISION_MODEL=qwen2.5vl:3b

# ----- 短信验证码（真实手机号登录）-----
# SMS_PROVIDER 三选一：aliyun（阿里云短信）/ twilio / webhook
# 不填写则自动进入「开发模式」：验证码直接显示在页面上，并打印到终端。
#
# 【阿里云短信】SMS_PROVIDER=aliyun
#   SMS_ACCESS_KEY_ID=你的AccessKeyId
#   SMS_ACCESS_KEY_SECRET=你的AccessKeySecret
#   SMS_SIGN_NAME=你的短信签名（需在阿里云审核通过）
#   SMS_TEMPLATE_CODE=你的模板CODE（如 SMS_123456789）
#   SMS_REGION_ID=cn-hangzhou
#   模板内容示例：您的验证码为 ${code}，5分钟内有效，请勿泄露。
#
# 【Twilio】SMS_PROVIDER=twilio
#   TWILIO_ACCOUNT_SID=
#   TWILIO_AUTH_TOKEN=
#   TWILIO_FROM=+1xxxxxxxxxx
#
# 【自建转发】SMS_PROVIDER=webhook
#   SMS_WEBHOOK_URL=https://你的服务/send
#   （会以 POST JSON { phone, code, signName, templateCode } 调用）
SMS_PROVIDER=

# 可选：登录 token 与链接预览软截止（毫秒，默认 8000，且不超过平台超时）
# AUTH_SECRET=
# LINK_PREVIEW_BUDGET_MS=8000
